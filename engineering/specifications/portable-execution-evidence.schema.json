{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnicoreagent.dev/schemas/execution-evidence/v1.json",
  "title": "OmniCoreAgent Portable Execution Evidence",
  "description": "Versioned, judgment-free execution evidence. Payloads may be redacted, truncated, offloaded, unavailable, or missing according to their capture descriptor.",
  "type": "object",
  "required": [
    "contract",
    "schema_version",
    "execution_id",
    "source",
    "adapter",
    "trace",
    "final_output_references",
    "missing_evidence",
    "facts"
  ],
  "properties": {
    "contract": { "const": "omnicoreagent.execution-evidence/v1" },
    "schema_version": { "const": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "task": { "type": ["object", "null"] },
    "trace": { "$ref": "#/$defs/trace" },
    "final_output_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": ["state", "source", "role"],
      "properties": {
        "state": {
          "enum": ["available", "redacted", "truncated", "offloaded", "not_recorded", "missing", "inferred"]
        },
        "source": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "reference": { "type": ["string", "null"] },
        "content_type": { "type": ["string", "null"] },
        "checksum": { "type": ["string", "null"] },
        "original_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "recorded_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "policy_version": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": ["boolean", "null"] },
        "metadata": { "type": "object" },
        "stack": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "required": ["trace_id", "span_id", "name", "kind", "actor", "status", "event_ids"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "parent_span_id": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "actor": { "$ref": "#/$defs/actor" },
        "status": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] },
        "ended_at": { "type": ["string", "null"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "input": { "type": ["object", "null"] },
        "output": { "type": ["object", "null"] },
        "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] },
        "token_usage": { "$ref": "#/$defs/usage" },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "attributes": { "type": "object" },
        "event_ids": { "type": "array", "items": { "type": "string" } },
        "schema_version": { "type": ["integer", "null"], "minimum": 1 },
        "input_capture": { "anyOf": [{ "$ref": "#/$defs/capture" }, { "type": "null" }] },
        "output_capture": { "anyOf": [{ "$ref": "#/$defs/capture" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": ["trace_id", "event_id", "event_type", "actor"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": ["string", "null"] },
        "parent_event_id": { "type": ["string", "null"] },
        "event_type": { "type": "string" },
        "actor": { "$ref": "#/$defs/actor" },
        "sequence_number": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": ["string", "null"] },
        "input": { "type": ["object", "null"] },
        "output": { "type": ["object", "null"] },
        "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "token_usage": { "$ref": "#/$defs/usage" },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "metadata": { "type": "object" },
        "schema_version": { "type": ["integer", "null"], "minimum": 1 },
        "input_capture": { "anyOf": [{ "$ref": "#/$defs/capture" }, { "type": "null" }] },
        "output_capture": { "anyOf": [{ "$ref": "#/$defs/capture" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "required": ["trace_id", "root_span_id", "status", "spans", "events", "evidence_status", "provenance"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "root_span_id": { "type": "string", "minLength": 1 },
        "parent_trace_id": { "type": ["string", "null"] },
        "parent_span_id": { "type": ["string", "null"] },
        "incomplete": { "type": "boolean" },
        "status": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] },
        "ended_at": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "suite_id": { "type": ["string", "null"] },
        "agent_id": { "type": ["string", "null"] },
        "workflow_id": { "type": ["string", "null"] },
        "metadata": { "type": "object" },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "schema_version": { "type": ["integer", "null"], "minimum": 1 },
        "execution_surface": { "type": "string" },
        "evidence_status": { "enum": ["complete", "partial", "unknown"] },
        "provenance": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
