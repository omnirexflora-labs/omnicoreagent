# A template for the support desk's settings. It holds no secrets.
# Copy it, change it, and point Compose at the copy:
#   cp apps/support_desk/env.example apps/support_desk/desk.env
#   DESK_ENV_FILE=desk.env docker compose -p support-desk -f apps/support_desk/compose.yml up -d

# The API's bearer token. Change it: every route but /health, /ready and
# /prometheus needs it.
OMNICOREAGENT_SERVE_AUTH_TOKEN=change-me

# The model. With no LLM_API_KEY in your shell the desk uses the fake provider.
# For a real model, export LLM_API_KEY (never write it in a file in this
# repository) and set the model's name here or in the shell.
DESK_MODEL=gpt-5.4-mini

# What the desk may spend, in dollars.
DESK_DAILY_USD=5.00
DESK_SESSION_USD=1.00
DESK_REQUEST_USD=0.50
DESK_REQUEST_TOOL_CALLS=20

# Send traces to an OTLP/HTTP collector too (for example Jaeger on 4318).
# Empty: traces stay in the desk's own store.
DESK_OTLP_ENDPOINT=

# The fake provider: how long each answer takes, and how often it fails.
# Rates are between 0 and 1. They can also be changed while it runs:
#   curl -X POST localhost:9000/_control -d '{"rate_429": 0.1}'
FAKE_LATENCY_MIN=0.8
FAKE_LATENCY_MAX=3.0
FAKE_RATE_429=0
FAKE_RATE_500=0
FAKE_RATE_TIMEOUT=0
FAKE_RATE_SLOW_STREAM=0
FAKE_RETRY_AFTER=1
