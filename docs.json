            "linkedin": "https://www.linkedin.com/in/abiola-a-06b66a1a4/"
        },
        "links": [
            {
                "header": "Resources",
                "items": [
                    {
                        "label": "Documentation",
                        "href": "https://github.com/omnirexflora-labs/omnicoreagent/tree/main/docs"
                    },
