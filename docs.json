{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "maple",
    "name": "OmniCoreAgent",
    "description": "The open Python agent runtime and harness, with an SDK, for production AI applications",
    "favicon": "/docs/assets/logo_light.svg",
    "colors": {
        "primary": "#0D9373",
        "light": "#07C983",
        "dark": "#0D9373"
    },
    "navbar": {
