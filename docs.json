    "fonts": {
        "family": "Inter"
    },
    "styling": {
        "eyebrows": "breadcrumbs",
        "codeblocks": {
            "theme": {
                "light": "github-light",
                "dark": "github-dark"
            }
        }
    },
    "integrations": {
        "telemetry": {
            "enabled": true
        }
    },
    "contextual": {
        "options": [
            "assistant",
            "copy",
            "view",
            "chatgpt",
            "claude",
            "perplexity",
            "mcp",
            "cursor",
            "vscode"
        ],
        "display": "header"
    }
}
