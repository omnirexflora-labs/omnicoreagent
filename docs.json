                            "docs/core-concepts/memory",
                            "docs/core-concepts/workspace-files",
                            "docs/core-concepts/context-engineering",
                            "docs/core-concepts/sub-agents",
                            "docs/core-concepts/events",
                            "docs/how-to-guides/models",
                            "docs/how-to-guides/configuration"
                        ]
                    },
                    {
                        "group": "Make It Safe",
                        "pages": [
                            "docs/core-concepts/security-model",
                            "docs/core-concepts/policies",
                            "docs/core-concepts/approvals",
                            "docs/core-concepts/execution",
                            "docs/how-to-guides/sandbox-providers",
                            "docs/core-concepts/budgets",
                            "docs/core-concepts/guardrails",
                            "docs/core-concepts/privacy"
                        ]
                    },
                    {
                        "group": "Run It",
                        "pages": [
                            "docs/core-concepts/durable-runs",
                            "docs/how-to-guides/stores-and-scale",
                            "docs/core-concepts/background-agents",
                            "docs/how-to-guides/omniserve",
                            "docs/how-to-guides/agent-in-a-container"
                        ]
                    },
                    {
                        "group": "See and Improve",
                        "pages": [
                            "docs/how-to-guides/read-a-run",
                            "docs/how-to-guides/observability",
                            "docs/how-to-guides/outcomes-and-training",
                            "docs/how-to-guides/headless-runs",
                            "docs/how-to-guides/harbor"
                        ]
                    },
                    {
                        "group": "How It Works",
                        "pages": [
                            "docs/core-concepts/agent-harness",
                            "docs/core-concepts/architecture"
                        ]
                    },
                    {
                        "group": "Reference",
                        "pages": [
                            "docs/reference/omnicoreagent",
                            "docs/reference/agent-config",
                            "docs/reference/telemetry-config",
                            "docs/reference/policy",
                            "docs/reference/background",
                            "docs/reference/budgets",
                            "docs/reference/cli"
                        ]
                    },
                    {
                        "group": "HTTP API (OmniServe)",
                        "openapi": "/docs/reference/openapi.json"
                    },
                    {
                        "group": "Releases",
                        "pages": [
                            "docs/upgrading",
                            "docs/changelog"
                        ]
                    }
                ]
            },
            {
                "dropdown": "Cookbook",
                "icon": "book-open",
                "description": "Runnable OmniCoreAgent examples by use case",
