            {
                "label": "GitHub",
                "href": "https://github.com/omnirexflora-labs/omnicoreagent",
                "icon": "github"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Get Started",
            "href": "/docs/getting-started/quickstart"
        }
    },
    "navigation": {
        "dropdowns": [
            {
                "dropdown": "Documentation",
                "icon": "book",
                "description": "Learn how to use OmniCoreAgent",
