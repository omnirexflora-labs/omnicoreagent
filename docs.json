                "label": "GitHub",
                "href": "https://github.com/omnirexflora-labs/omnicoreagent",
                "icon": "github"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Get Started",
            "href": "/docs/getting-started/quickstart"
        }
    },
    "navigation": {
        "dropdowns": [
            {
                "dropdown": "Documentation",
                "icon": "book",
                "description": "Learn how to use OmniCoreAgent",
                "groups": [
                    {
                        "group": "Get Started",
                        "pages": [
                            "docs/index",
                            "docs/getting-started/installation",
                            "docs/getting-started/quickstart",
                            "docs/getting-started/tour",
                            "docs/comparison",
                            "docs/getting-started/use-docs-with-ai-tools"
                        ]
                    },
                    {
                        "group": "Build",
                        "pages": [
                            "docs/core-concepts/overview",
                            "docs/how-to-guides/basic-usage",
                            "docs/core-concepts/local-tools",
                            "docs/how-to-guides/advanced-tools",
                            "docs/core-concepts/mcp",
                            "docs/core-concepts/skills",
                            "docs/core-concepts/code-mode",
                            "docs/core-concepts/agents-md",
                            "docs/core-concepts/memory",
                            "docs/core-concepts/workspace-files",
                            "docs/core-concepts/context-engineering",
                            "docs/core-concepts/sub-agents",
                            "docs/core-concepts/events",
                            "docs/how-to-guides/models",
                            "docs/how-to-guides/configuration"
                        ]
                    },
                    {
                        "group": "Make It Safe",
                        "pages": [
                            "docs/core-concepts/security-model",
                            "docs/core-concepts/guardrails",
                            "docs/core-concepts/execution",
                            "docs/how-to-guides/sandbox-providers"
                        ]
                    },
                    {
                        "group": "Run It",
                        "pages": [
                            "docs/core-concepts/durable-runs",
                            "docs/core-concepts/background-agents",
                            "docs/how-to-guides/omniserve",
                            "docs/how-to-guides/agent-in-a-container"
                        ]
                    },
                    {
                        "group": "See and Improve",
                        "pages": [
                            "docs/how-to-guides/observability",
                            "docs/how-to-guides/headless-runs",
                            "docs/how-to-guides/harbor"
                        ]
                    },
                    {
                        "group": "How It Works",
                        "pages": [
                            "docs/core-concepts/agent-harness",
                            "docs/core-concepts/architecture"
                        ]
                    },
                    {
                        "group": "Reference",
                        "pages": [
                            "docs/reference/omnicoreagent",
                            "docs/reference/agent-config",
                            "docs/reference/telemetry-config",
                            "docs/reference/policy",
                            "docs/reference/background",
                            "docs/reference/budgets",
                            "docs/reference/cli"
                        ]
                    },
                    {
                        "group": "HTTP API (OmniServe)",
                        "openapi": "/docs/reference/openapi.json"
                    },
                    {
                        "group": "Releases",
                        "pages": [
                            "docs/upgrading",
                            "docs/changelog"
                        ]
                    }
                ]
            },
            {
                "dropdown": "Cookbook",
                "icon": "book-open",
                "description": "Runnable OmniCoreAgent examples by use case",
                "groups": [
                    {
                        "group": "Examples",
                        "pages": [
                            "cookbook/README",
                            "cookbook/getting_started/README",
                            "cookbook/real_applications/README",
