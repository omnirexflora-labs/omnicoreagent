{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "maple",
    "name": "OmniCoreAgent",
    "description": "The governed runtime for Python agents you can let act.",
    "favicon": "/assets/brand/omnicoreagent-mark.svg",
    "logo": {
        "light": "/assets/brand/omnicoreagent-logo-light.svg",
        "dark": "/assets/brand/omnicoreagent-logo-dark.svg"
    },
    "colors": {
        "primary": "#8A45E6",
        "light": "#A673F5",
        "dark": "#7A36D6"
    },
    "navbar": {
